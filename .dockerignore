# Never in the image: secrets, private notes, history, raw downloads, local builds.
.env
.env.*
!.env.example
CLAUDE.local.md
.claude/
.git/
.githooks/
.idea/
.vscode/
data/raw/
# Local runs stay out: the image takes the featured runs from backend/tests/fixtures/runs.
data/runs/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.hypothesis/
**/.mypy_cache/
backend/.venv/
frontend/node_modules/
frontend/dist/
