#!/bin/sh
# Block commits that contain secrets. Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit blocked." >&2
  exit 1
fi
# .gitleaks.toml adds the shapes of the project's own API keys to the default rules.
exec gitleaks git --pre-commit --staged --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
