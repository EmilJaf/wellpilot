{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "wellpilot.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "api-running",
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "wellpilot.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WELLPILOT_API=http://localhost:8001",
        "pnpm",
        "--dir",
        "frontend",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "api-nokey",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BASETEN_API_KEY=",
        "MODEL_API_KEY=",
        "PYTHON_SANDBOX=false",
        "uv",
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "wellpilot.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
