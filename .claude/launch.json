{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "wellpilot.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-running",
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
