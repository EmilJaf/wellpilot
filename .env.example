# Copy to .env and fill in. Never commit .env.

# Which provider the agent uses: baseten | meta
LLM_PROVIDER=baseten

# Primary: Muse Spark Open on Baseten
BASETEN_API_KEY=

# Fallback: Muse Spark on the Meta Model API
MODEL_API_KEY=

# Public deployment (set as Fly secrets, never in the repo)
# Run ids listed by GET /api/runs and replayed by "Replay a recorded run". In public with
# none set, no run is listed: visitors' questions are never shown to other visitors.
# FEATURED_RUNS=6fe2c784147c
# Sent from the browser as X-Operator-Key (localStorage.operatorKey): lifts the per-client
# and daily limits so the demo cannot be locked out. Generate a long random value.
# OPERATOR_KEY=
# PUBLIC=true          # automatic on Fly (FLY_APP_NAME is set)
# TRUSTED_PROXY=auto   # fly | xff | none; auto = fly on Fly, else none
# DAILY_TOKEN_BUDGET=3000000
# RUN_TIMEOUT_S=600
# run_python: the agent's own code in Modal Sandboxes. Locally `uv run modal token new`
# writes ~/.modal.toml; on Fly set the two values from Modal's dashboard as secrets.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# PYTHON_SANDBOX=false  # turn the tool off even where Modal is set up

# Optional overrides (defaults live in backend/src/wellpilot/config.py)
# DATA_DIR=/absolute/path/to/data
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/wellpilot.db
