  ]
 },
 "submission": {
  "summary": "Over 2011 to 2013 F-12’s monthly water cut and choke showed a moderate positive co-movement, with water cut rising from about 72% to about 95% while choke was already wide open around 100%; the calculation suggests Pearson correlation about 0.68 (Spearman about 0.48) over 36 months, most likely reflecting concurrent reservoir water advance rather than choke driving water cut.",
  "findings": [
   {
    "claim": "Over 2011-01 to 2013-12 F-12’s monthly water cut and choke opening had a Pearson correlation of 0.68 across 36 months, Spearman 0.48, both statistically significant.",
    "detail": "Correlation computed from production_monthly E1 values (water_cut 0.719 to 0.9467, choke_pct 50.38 to 100.0); Pearson r 0.6835 p 4.34e-06, Spearman r 0.4834 p 0.0028, n=36 via agent code E4 (inference, code-typed numbers). Water_cut mean 0.8406, choke mean 87.37.",
    "evidence_ids": [
     "E1",
     "E4"
    ],
    "confidence": "inference",
    "numbers": [
     {
      "text": "0.68",
      "value": 0.6835,
      "evidence_id": "E4"
     },
     {
      "text": "36",
      "value": 36,
      "evidence_id": "E4"
     },
     {
      "text": "0.48",
      "value": 0.4834,
      "evidence_id": "E4"
     }
    ]
   },
   {
    "claim": "Water cut rose continuously from 72% in early 2011 to 95% in late 2013 while choke went from about 50% to pegged near 100% in 2012-2013, so water cut kept rising after choke had no further room.",
    "detail": "E1: 2011-01 water_cut 0.7232 choke 50.38%; 2013-12 water_cut 0.9467 choke 94.53%; 2012-08 choke 100.0. By-year E3: 2011 water_cut 0.7586 choke 77.11% liquid 4970 Sm3/d; 2012 water_cut 0.8604 choke 100% liquid 5260; 2013 water_cut 0.9044 choke 99.61% liquid 5096.",
    "evidence_ids": [
     "E1",
     "E3"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "72%",
      "value": 0.7232,
      "evidence_id": "E1"
     },
     {
      "text": "95%",
      "value": 0.9467,
      "evidence_id": "E1"
     },
     {
      "text": "50%",
