      "value": 1133053,
      "evidence_id": "E2"
     },
     {
      "text": "253.9",
      "value": 253.85,
      "evidence_id": "E2"
     }
    ]
   },
   {
    "claim": "Well performance continued after the gauge failed: average WHP on 2010-10-01 to 2010-10-11 was 57.0 bar with BHP 273 bar, and average WHP after failure 2010-10-12 to 2010-10-31 was 53.3 bar with oil 1 679 Sm3/d, showing no pressure collapse.",
    "evidence_ids": [
     "E5",
     "E8",
     "E9"
    ],
    "confidence": "inference",
    "numbers": [
     {
      "text": "57.0",
      "value": 56.95,
      "evidence_id": "E8"
     },
     {
      "text": "273",
      "value": 273.38,
      "evidence_id": "E8"
     },
     {
      "text": "53.3",
      "value": 53.26,
      "evidence_id": "E9"
     },
     {
      "text": "1 679",
      "value": 1679,
      "evidence_id": "E9"
     }
    ]
   },
   {
    "claim": "Production ingest flagged the zeros as zero_gauge_reading and set them missing from 2010-10-12 onward, which is why monthly BHP is null from 2010-11 onward while WHP stays around 50.7 bar and oil continues.",
    "evidence_ids": [
     "E4",
     "E6"
    ],
    "confidence": "fact",
    "numbers": [
