 "submission": {
  "summary": "F-12's missing downhole pressure after 2010-10-12 is a sensor failure, not a reservoir pressure collapse. The gauge read zero while the well kept flowing for 1 830 days producing 1.13 million Sm3 oil with stable wellhead pressure around 53.3 bar.",
  "findings": [
   {
    "claim": "BHP gauge failed on 2010-10-12 and stayed zero for 2 095 days to 2016-09-17 while the well kept flowing on 1 830 days producing 1 133 053 Sm3 oil; last good BHP was 253.9 bar on 2010-10-11, indicating sensor failure not pressure collapse.",
    "evidence_ids": [
     "E2",
     "E5",
     "E6"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "2 095",
      "value": 2095,
      "evidence_id": "E2"
     },
     {
      "text": "1 830",
      "value": 1830,
