   },
   {
    "claim": "Monthly oil rate fell from 785 Sm3/d in October 2018 to 512 Sm3/d in November 2018.",
    "detail": "2018-10 oil_rate_per_producing_day 784.73, bhp 203.33, choke 70%, liquid_rate 798.7 Sm3/d; 2018-11 oil_rate 511.91, bhp 224.39, choke 44.29% monthly mean, liquid_rate 521.88 Sm3/d.",
