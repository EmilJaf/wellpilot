 },
 "submission": {
  "summary": "F-12's missing downhole pressure after 2010-10-12 is a sensor failure, not a reservoir collapse. The gauge began reading 0 on 2010-10-12 while oil production continued uninterrupted for 2 095 days, producing 1 133 053 Sm3 oil with normal wellhead pressure and choke.",
  "findings": [
   {
    "claim": "F-12's downhole gauge failed on 2010-10-12: last good BHP was 253.85 bar on 2010-10-11, then BHP read 0 and was set to missing for 2 095 days from 2010-10-12 to 2016-09-17.",
    "evidence_ids": [
     "E3",
     "E4",
     "E6"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "253.85",
      "value": 253.85,
      "evidence_id": "E3"
     },
     {
      "text": "2 095",
      "value": 2095,
      "evidence_id": "E3"
     },
     {
      "text": "0",
      "value": 0,
      "evidence_id": "E4"
     }
    ]
   },
   {
    "claim": "The well kept flowing during the missing-BHP period: it flowed on 1 830 days and produced 1 133 053 Sm3 oil, with average wellhead pressure 37.82 bar and average choke 75.87%, proving pressure had not collapsed.",
    "evidence_ids": [
     "E3",
     "E5"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "1 830",
      "value": 1830,
      "evidence_id": "E3"
     },
     {
      "text": "1 133 053",
      "value": 1133053,
      "evidence_id": "E3"
     },
     {
      "text": "37.82",
      "value": 37.82,
      "evidence_id": "E5"
     },
     {
      "text": "75.87%",
      "value": 75.87,
      "evidence_id": "E5"
     }
    ]
   },
   {
    "claim": "Production was continuous across the failure date: on 2010-10-11 oil was 1 765 Sm3 with WHP 54.27 bar, on 2010-10-12 oil was 1 759 Sm3 with WHP 54.11 bar and BHP missing, showing no rate drop.",
    "evidence_ids": [
     "E6",
     "E10"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "1 765",
      "value": 1765,
      "evidence_id": "E6"
     },
     {
      "text": "54.27",
      "value": 54.27,
      "evidence_id": "E6"
     },
     {
      "text": "1 759",
      "value": 1759,
      "evidence_id": "E6"
     },
     {
      "text": "54.11",
      "value": 54.11,
      "evidence_id": "E6"
     }
    ]
   },
   {
    "claim": "The ingest log confirms a sensor issue, not reservoir depletion: from 2010-10-12 every day is flagged zero_gauge_reading with action set_missing and dp_tubing_without_bhp set_missing.",
    "evidence_ids": [
     "E4"
    ],
    "confidence": "fact",
    "numbers": [
     {
      "text": "54.11",
      "value": 54.11,
      "evidence_id": "E4"
     }
    ]
   },
   {
    "claim": "Missing BHP is therefore a downhole sensor failure, not a reservoir pressure problem; the well produced normally for almost 6 years after, with monthly oil rates around 1 546 to 1 213 Sm3/d in late 2010 to mid-2011 and continued production through 2016.",
    "evidence_ids": [
     "E2",
     "E7",
     "E3"
    ],
    "confidence": "inference",
