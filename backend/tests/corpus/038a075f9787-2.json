  {
   "id": "E5",
   "tool": "run_python",
   "arguments": {
    "code": "import pandas as pd, numpy as np\nfrom scipy.stats import pearsonr\n\ndf = sql(\"SELECT strftime(date_trunc('month', date), '%Y-%m') as month, avg(water_cut) as water_cut, avg(choke_pct) as choke_pct FROM production_daily WHERE well='F-12' AND date >= '2011-01-01' AND date < '2014-01-01' AND on_stream_hrs >= 12 GROUP BY 1 ORDER BY 1\")\n\ndf['water_cut'] = df['water_cut'].astype(float)\ndf['choke_pct'] = df['choke_pct'].astype(float)\n\nfrom scipy.stats import pearsonr\nr_level, p_level = pearsonr(df['water_cut'], df['choke_pct'])\ndf['wc_diff'] = df['water_cut'].diff()\ndf['choke_diff'] = df['choke_pct'].diff()\ndf2 = df.dropna(subset=['wc_diff','choke_diff'])\nr_diff, p_diff = pearsonr(df2['wc_diff'], df2['choke_diff'])\nresult = {\"n\": int(len(df)), \"r_level\": float(r_level), \"p_level\": float(p_level), \"r_diff\": float(r_diff), \"p_diff\": float(p_diff), \"mean_wc\": float(df['water_cut'].mean()), \"mean_choke\": float(df['choke_pct'].mean()), \"rows\": df.to_dict(orient=\"records\")}\n",
