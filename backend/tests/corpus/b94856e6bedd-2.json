    "code": "import pandas as pd\n# Use sql to get monthly aggregated? But we have production_monthly rows already. Let's use sql for precise\ndf = sql(\"SELECT date_trunc('month', date)::DATE as month, avg(choke_pct) as choke, avg(water_cut) as wc FROM production_daily WHERE well='F-12' AND date BETWEEN '2011-01-01' AND '2013-12-31' AND flow_kind='production' GROUP BY 1 ORDER BY 1\")\n# Also compute via daily\ndaily_df = sql(\"SELECT date, choke_pct, water_cut FROM production_daily WHERE well='F-12' AND date BETWEEN '2011-01-01' AND '2013-12-31' AND flow_kind='production' AND choke_pct IS NOT NULL AND water_cut IS NOT NULL\")\n# compute correlations\nimport numpy as np\nmonthly_corr = df['choke'].corr(df['wc'])\ndaily_corr = daily_df['choke_pct'].corr(daily_df['water_cut'])\n# also get monthly table for reporting\nresult = {\"monthly\": df.to_dict(orient=\"records\"), \"monthly_corr\": float(monthly_corr) if not pd.isna(monthly_corr) else None, \"daily_corr\": float(daily_corr) if not pd.isna(daily_corr) else None, \"n_months\": len(df), \"n_daily\": len(daily_df)}\nresult"
